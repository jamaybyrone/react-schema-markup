{
  "name": "react-schema-markup",
  "version": "1.4.0",
  "description": "A React library for integrating structured-data (JSON-LD) into React applications.",
  "homepage": "https://github.com/jamaybyrone/react-schema-markup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamaybyrone/react-schema-markup.git"
  },
  "bugs": {
    "url": "https://github.com/jamaybyrone/react-schema-markup/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "schema",
    "json-ld",
    "markup",
    "structured-data",
    "seo",
    "breadcrumb",
    "react-library",
    "structured-data-markup"
  ],
  "author": "Jamie Byrne",
  "scripts": {
    "build": "webpack --config webpack.config.js && tsc --emitDeclarationOnly && tsc-alias",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "test": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer"
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/github",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "dependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "schema-dts": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
